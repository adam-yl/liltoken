# Publish source only. Local app state and build output never belong in Git.
/*
!/.gitignore
!/README.md
!/LICENSE
!/Info.plist
!/Sources/
!/Tests/
!/scripts/

/Sources/*
!/Sources/*.swift
/Tests/*
!/Tests/*.swift
!/Tests/statusline-smoke.py
/scripts/*
!/scripts/*.sh
!/scripts/*.py

**/.DS_Store
**/.build/
**/.runtime/
**/__pycache__/
**/*.pyc
**/*.app/
**/*.dSYM/
**/*.log
**/.env
**/.env.*
**/*.pem
**/*.key
